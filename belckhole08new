# ======================= ASOSIY OYNA =======================
def open_main_app():
    global root
    root = tk.Tk()
    root.title("BLACKHOLE ")
    root.geometry("750x1000")
    root.config(bg="#000000")

    # ================= Canvas + movable frame =================
    canvas = tk.Canvas(root, bg="#000000", highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    
    main_frame = tk.Frame(canvas, bg="#000000")
    
    window_id = canvas.create_window((0, 0), window=main_frame, anchor="nw")
    
    # Scroll region yangilash
    def on_configure(event):
        canvas.configure(scrollregion=canvas.bbox("all"))
    
    main_frame.bind("<Configure>", on_configure)
    
    # Frame kengligini canvas kengligiga tenglashtirish
    def resize_frame(event):
        canvas.itemconfig(window_id, width=event.width)
    
    canvas.bind("<Configure>", resize_frame)
    
    # Mouse wheel bilan tepaga-pastga
    def scroll_move(event):
        canvas.yview_scroll(int(-1*(event.delta/120)), "units")
    
    canvas.bind_all("<MouseWheel>", scroll_move)
    # ================= Asosiy kontent =================
    top_bar = tk.Frame(main_frame, bg="#000000")
    top_bar.pack(fill="x", pady=5)
    tk.Button(top_bar, text="⚙️ Settings", bg="#000000", fg="white", command=settings).pack(side="left", padx=15)
    tk.Button(top_bar, text="❓ Help", bg="#000000", fg="white", command=help_menu).pack(side="left", padx=15)
    tk.Button(top_bar, text="ℹ️ About", bg="#000000", fg="white", command=about).pack(side="right", padx=15)

    tk.Label(main_frame, text="BLACKHOLE", font=("Arial", 34, "bold"), fg="#FF0000", bg="#000000").pack(pady=80)

    categories = [
        ("SHIFRLAR", open_shifrlar),
        ("MATEMATIKA", open_matematika),
        ("KONVERTERLAR", open_konverterlar),
        ("QIZIQLI", open_qiziqarli),
    ]

    for text, cmd in categories:
        tk.Button(main_frame, text=text, width=40, height=5, font=("Arial", 18, "bold"),
                  bg="#111111", fg="#FFFFFF", highlightbackground="#FF0000", highlightthickness=4,
                  command=cmd).pack(pady=30)

    status = tk.Label(main_frame, text="© Bexruz Xoshimov | Temurbeklar maktabi | 2025",
                      fg="#00FF00", bg="#111111", font=("Consolas", 11), relief="sunken")
    status.pack(side="bottom", fill="x")

    apply_dark(main_frame)
    root.mainloop()
