    savol_javob = {
        "salom": ["AI: Salom Bexruz 👋", "Hey Bexruz 😎", "Assalom! 😊"],
        "assalom": ["AI: Salom Bexruz 👋", "Hey Bexruz 😎", "Assalom! 😊"],
