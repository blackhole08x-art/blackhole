# ======================= DARK MODE =======================
def apply_dark(win):
    for w in win.winfo_children():
        if isinstance(w, (tk.Label, tk.Button, tk.Frame)):
            w.config(bg="#000000", fg="#FFFFFF")
        elif isinstance(w, tk.Entry):
            w.config(bg="#111111", fg="#FFFFFF", insertbackground="white")
        elif isinstance(w, (tk.Text, scrolledtext.ScrolledText)):
            w.config(bg="#000000", fg="#FF0000", insertbackground="white")
        if hasattr(w, "winfo_children"):
            apply_dark(w)

# ======================= UNDOABLE TEXT =======================
class UndoableText(scrolledtext.ScrolledText):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.history = []
        self.index = -1
        self.max = 50
        self.bind("<KeyRelease>", self.save)

    def save(self, event=None):
        if event and event.keysym in ("Control_L", "Control_R", "Shift_L", "Shift_R"):
            return
        txt = self.get(1.0, tk.END)
        if self.history and self.history[self.index] == txt:
            return
        self.index += 1
        self.history = self.history[:self.index]
        self.history.append(txt)
        if len(self.history) > self.max:
            self.history.pop(0)
            self.index -= 1

    def undo(self):
        if self.index > 0:
            self.index -= 1
            self.delete(1.0, tk.END)
            self.insert(tk.END, self.history[self.index])

    def redo(self):
        if self.index < len(self.history) - 1:
            self.index += 1
            self.delete(1.0, tk.END)
            self.insert(tk.END, self.history[self.index])

