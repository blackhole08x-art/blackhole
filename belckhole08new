def open_quadratic():
    win = tk.Toplevel(root)
    win.title("Kvadrat Tenglama Yechish")
    win.geometry("600x650")
    win.config(bg="#000000")

    tk.Label(win, text="KVADRAT TENGLAMA", font=("Arial", 24, "bold"), fg="#FF0000", bg="#000000").pack(pady=30)

    f = tk.Frame(win, bg="#000000"); f.pack(pady=20)
    tk.Label(f, text="a =", font=20, fg="#FFFFFF", bg="#000000").grid(row=0, column=0, padx=30)
    a = tk.Entry(f, width=15, font=20, bg="#111111", fg="#FFFFFF"); a.grid(row=0, column=1)
    tk.Label(f, text="b =", font=20, fg="#FFFFFF", bg="#000000").grid(row=1, column=0, padx=30, pady=20)
    b = tk.Entry(f, width=15, font=20, bg="#111111", fg="#FFFFFF"); b.grid(row=1, column=1)
    tk.Label(f, text="c =", font=20, fg="#FFFFFF", bg="#000000").grid(row=2, column=0, padx=30)
    c = tk.Entry(f, width=15, font=20, bg="#111111", fg="#FFFFFF"); c.grid(row=2, column=1)

    out = tk.Text(win, height=10, font=18, bg="#000000", fg="#FF0000")
    out.pack(padx=40, pady=40, fill="both", expand=True)

    def solve():
        try:
            aa = float(a.get() or 0)
            bb = float(b.get() or 0)
            cc = float(c.get() or 0)
            if aa == 0:
                out.delete(1.0, tk.END); out.insert(tk.END, "a ≠ 0!")
                return
            D = bb**2 - 4*aa*cc
            if D > 0:
                x1 = (-bb + math.sqrt(D)) / (2*aa)
                x2 = (-bb - math.sqrt(D)) / (2*aa)
                res = f"x₁ = {x1:.4f}\nx₂ = {x2:.4f}"
            elif D == 0:
                x = -bb / (2*aa)
                res = f"x = {x:.4f}"
            else:
                res = "Haqiqiy yechim yo'q"
            out.delete(1.0, tk.END); out.insert(tk.END, res)
        except:
            out.delete(1.0, tk.END); out.insert(tk.END, "Son kiriting!")

    tk.Button(win, text="HISOBLASH", width=20, height=2, command=solve).pack(pady=20)
    apply_dark(win)

