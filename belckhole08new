        "isming nima": ["AI: Men Bexruzning sun'iy intellektiman 🤖"],
        "sen kimsan": ["AI: Men Bexruzning sun'iy intellektiman 🤖"],

        "qalesan": ["AI: Zo'rman 😎 Sen-chi?"],

        "python nima": ["AI: Python bu mashhur dasturlash tili 🐍"],

        "ai nima": ["AI: AI — sun'iy intellekt degani 🤖"],

        "hazil ayt": ["AI: Dasturchilar choy ichmaydi, ular bug tuzatadi ☕😂"]
    }

    # 1 dan 1000 gacha avtomatik savol
    for i in range(1, 1001):
        savol_javob[f"savol{i}"] = [f"AI: Bu savol {i} raqamli javob"]

    # Javob funksiyasi
    def javob(event=None):
        user_input = entry.get()
        if not user_input.strip():
            return

        # Chatga foydalanuvchi yozuvi
        chat_text.config(state=tk.NORMAL)
        chat_text.insert(tk.END, f"Sen: {user_input}\n")
        chat_text.config(state=tk.DISABLED)

        text_lower = user_input.lower()
        response = "AI: Tushunmadim 🙂"

        import datetime, difflib, random
        # Closest match
        mos = difflib.get_close_matches(text_lower, savol_javob.keys(), n=1, cutoff=0.6)
        if mos:
            javoblar = savol_javob[mos[0]]
            response = random.choice(javoblar)
        elif "sana" in text_lower or "bugun" in text_lower:
            today = datetime.datetime.now().strftime("%d-%m-%Y")
            response = f"AI: Bugun sana {today}"
        elif "vaqt" in text_lower or "soat" in text_lower:
            now = datetime.datetime.now().strftime("%H:%M")
            response = f"AI: Hozir soat {now}"
        elif text_lower in ["exit", "chiqish", "yopish"]:
            chat_win.destroy()
            return

        # Chatga AI javobi
        chat_text.config(state=tk.NORMAL)
        chat_text.insert(tk.END, f"{response}\n\n")
        chat_text.config(state=tk.DISABLED)
        chat_text.see(tk.END)

        entry.delete(0, tk.END)

    # Enter tugmasi va yuborish tugmasi
    entry.bind("<Return>", javob)
    tk.Button(chat_win, text="Yuborish", font=("Arial", 14), command=javob).pack(pady=5)
