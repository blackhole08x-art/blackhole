    win.title("Calculator Pro")
    win.geometry("500x700")
    win.config(bg="#000000")

    entry = tk.Entry(win, width=30, font=("Arial", 24), bg="#111111", fg="#00FFFF", justify="right", insertbackground="white")
    entry.pack(pady=20, padx=20)

    frame = tk.Frame(win, bg="#000000"); frame.pack(pady=10)

    def click(btn):
        if btn == "C":
            entry.delete(0, tk.END)
        elif btn == "←":
            entry.delete(len(entry.get())-1, tk.END)
        elif btn == "=":
            try:
                res = eval(entry.get())
                entry.insert(tk.END, f" = {res}")
            except:
                entry.insert(tk.END, " XATO")
        else:
            entry.insert(tk.END, btn)

    buttons = [
        ('C', 'red'), ('←', 'orange'), ('/', 'orange'), ('*', 'orange'),
        ('7', 'gray'), ('8', 'gray'), ('9', 'gray'), ('-', 'orange'),
        ('4', 'gray'), ('5', 'gray'), ('6', 'gray'), ('+', 'orange'),
        ('1', 'gray'), ('2', 'gray'), ('3', 'gray'), ('=', 'green'),
        ('0', 'gray'), ('.', 'gray'), ('(', 'orange'), (')', 'orange')
    ]

    row = col = 0
    for (text, color) in buttons:
        fg_color = "red" if color == "red" else "black" if color == "green" else "white"
        bg_color = "#006400" if color == "green" else "#8B4513" if color == "orange" else "#000000"
        tk.Button(frame, text=text, width=6, height=3, font=("Arial", 18, "bold"),
                  bg=bg_color, fg=fg_color, command=lambda t=text: click(t)).grid(row=row, column=col, padx=5, pady=5)
        col += 1
        if col > 3:
            col = 0
            row += 1

    apply_dark(win)

