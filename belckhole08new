        out.delete(1.0, tk.END)
        out.insert(tk.END, f"Ingliz:    {en}\n\nRus:    {ru}\n\nFransuz: {fr}")

    tk.Button(win, text="TARJIMA QILISH", width=25, height=2, command=tarjima).pack(pady=20)
    apply_dark(win)

